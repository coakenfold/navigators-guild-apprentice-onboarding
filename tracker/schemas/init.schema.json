{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.invalid/schemas/init.schema.json",
  "title": "tracker init --json",
  "type": "object",
  "required": ["home", "created", "repaired"],
  "properties": {
    "home": {
      "description": "The store's folder.",
      "type": "string",
      "minLength": 1
    },
    "created": {
      "description": "False if the store already existed.",
      "type": "boolean"
    },
    "repaired": {
      "description": "The parts of an existing store that were missing and have been put back. Empty for a new store, and for a store that was complete.",
      "type": "array",
      "items": { "enum": ["config.json", "counters.json", "items/"] },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
